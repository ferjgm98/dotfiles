.DS_Store
**/.DS_Store

# Local state / caches that shouldn't be committed
**/.zcompdump*

# Extras capture output (still versioned, but keep OS junk out)
extras/**/.DS_Store

# Machine-local settings and credentials
.env
.env.*
!.env.example
.zshrc.local
extras/home/.npmrc
**/*.bak.*
**/__pycache__/

# Generated by Antidote
zsh/.zsh_plugins.zsh

# Terminal runtime state is not portable configuration.
herdr/session*.json
herdr/*.log
herdr/.plugins.lock
herdr/release-notes.json
cmux/*.sock
cmux/session*.json
